# "local" is for development on http://localhost. On a server set APP_ENV=production:
# that makes the session cookie Secure (it is then only sent over HTTPS, so reach the app
# through TLS, see docs/deployment.md), enables the startup secret checks and hides
# /docs, /redoc and /openapi.json.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://quantfolio:PASSWORD@localhost:5432/quantfolio
# With the local docker-compose Redis (it requires a password): redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0
REDIS_URL=redis://localhost:6379/0
# Address uvicorn listens on. Split deployment: the app LXC's LAN address. Single node: 127.0.0.1.
API_HOST=0.0.0.0
API_PORT=8000
# Proxy addresses uvicorn trusts X-Forwarded-For from (the web LXC running Caddy; 127.0.0.1 on a
# single node). Required for the login lockout and rate limits to see real client addresses.
# Never "*": anyone could then pick their own bucket.
FORWARDED_ALLOW_IPS=127.0.0.1
LOG_LEVEL=info
# Must be replaced outside local development: `openssl rand -hex 32`
JWT_SECRET=change-this-before-use
ENCRYPTION_KEY=
PASSWORD_RESET_TOKEN=
# One-time token the first account registration must present. Leave empty to have a random one
# generated, logged at WARNING ("FIRST-RUN SETUP") and written 0600 to DATA_DIR/setup_token.
SETUP_TOKEN=
# Directory for small state files such as setup_token. Default: /var/lib/quantfolio when writable,
# else <repo>/.quantfolio.
DATA_DIR=
# Optional Host allow-list (comma-separated, no ports); empty = any host. Include 127.0.0.1 and
# localhost if health checks call the API directly.
ALLOWED_HOSTS=
# Bearer key for a llama-server started with LLAMA_API_KEY (the same value). Optional alternative:
# store it as the Local LLM credential in Control Center.
LLM_API_KEY=
DKB_FINTS_URL=https://fints.dkb.de/fints
DKB_BLZ=12030000
FRONTEND_ORIGIN=http://localhost:5173
OPENBB_API_URL=http://127.0.0.1:6900
OBSIDIAN_REST_URL=http://127.0.0.1:27123
# Passkeys: the relying-party ID is the host name the browser sees (no scheme, no port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=QuantFolio
JWT_EXPIRY_HOURS=24
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Optional tunables (defaults shown; leave commented unless you need them) -----------------
# Research engines. FinRL trains CPU-only PPO agents; Qlib is an unused legacy switch.
# FINRL_ENABLED=true
# QLIB_ENABLED=false
# Database connection pool (Postgres).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# Market data.
# YFINANCE_REQUEST_TIMEOUT_S=30
# PER_PROVIDER_TIMEOUT_S=30
# JUSTETF_REQUEST_TIMEOUT_S=30
# PRICE_BACKFILL_WORKERS=
# OPENFIGI_API_KEY=
# News feeds, comma-separated (the Control Center's News → Feeds list wins when set).
# RSS_FEED_URLS=
# Discover.
# DISCOVER_LLM_MAX_CANDIDATES=15
# DISCOVER_PREDICTION_HORIZON_TRADING_DAYS=21
# PREINGEST_TIMEOUT_S=120
# Comma-separated YYYY-MM-DD dates on which the daily advisor cycle does not run.
# ADVISOR_MARKET_HOLIDAYS=
# Cache and artefact directories.
# QUANT_FACTORS_FF_CACHE_DIR=/tmp/quantfolio_ff_cache
# QUANTFOLIO_PARQUET_PANEL_DIR=
# QUANTFOLIO_SIGNAL_BATCH_DIR=
