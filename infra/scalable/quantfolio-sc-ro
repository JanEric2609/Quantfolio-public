#!/bin/bash
# quantfolio-sc-ro: root-owned, read-only allow-list in front of Scalable
# Capital's official `sc` CLI. Quantfolio runs it as
#
#   sudo -n -H -u scalable-cli-user -- /usr/local/libexec/quantfolio-sc-ro <args> --json
#
# and sudoers allows only this file, never `sc` itself. The whole argv must be
# one of the read commands below (the same list as ALLOWED_COMMANDS in
# backend/app/foundation/scalable/cli.py); anything else exits 10 without
# starting sc. Keep the two lists identical; tests/test_scalable.py checks it.
#
# The one exception is the login the Control Center starts
# (backend/app/foundation/scalable/login.py): exactly `login --local-read-only`,
# two words, nothing else. That session refuses every GraphQL mutation, and
# `allowed_isins = []` in config.toml still refuses every order.
#
# Install (root):  install -o root -g root -m 0755 quantfolio-sc-ro /usr/local/libexec/quantfolio-sc-ro
#
# sc needs glibc >= 2.38. On an older system (Debian 12 has 2.36) install.sh
# puts Debian 13's glibc in $RUNTIME, and sc is started through that loader;
# nothing else on the host uses it. The sc binary itself stays the official,
# verified one, so its pinned SHA-256 still applies.
set -euo pipefail
umask 077

readonly SC=/usr/local/bin/sc
readonly RUN_AS=scalable-cli-user
readonly RUNTIME=/usr/local/lib/quantfolio-sc-runtime

refuse() {
  # $1 exit code, $2 sc-style error code, $3 message (fixed text, no quotes)
  printf '{"ok":false,"command":"quantfolio-sc-ro","error":{"code":"%s","message":"%s"},"hints":[]}\n' "$2" "$3"
  exit "$1"
}

# One sc at a time for this session owner: the API and the worker both call
# in, and two processes refreshing the rotating refresh token at once log the
# session out. The lock is held until sc exits (fd 9 survives the exec).
# install.sh holds the same lock while it replaces $RUNTIME, so how sc starts
# (through the private glibc when install.sh set one up) is decided only once
# the lock is ours, never halfway through a replacement.
lock_session() {
  home="$(getent passwd "$RUN_AS" | cut -d: -f6)"
  [[ -n "$home" && -d "$home" ]] || refuse 1 internal_error "no home directory for the CLI user"
  mkdir -p "$home/.config/scalable-cli"
  exec 9>"$home/.config/scalable-cli/.quantfolio-sc.lock"
  flock -w "$1" 9 || refuse 30 rate_limited "another sc call is still running"
  if [[ -x "$RUNTIME/ld.so" ]]; then
    run_sc=("$RUNTIME/ld.so" --library-path "$RUNTIME" "$SC")
  else
    run_sc=("$SC")
  fi
}

[[ "$(id -un)" == "$RUN_AS" ]] || refuse 10 command_not_allowed "must run as $RUN_AS"

if (( $# == 2 )) && [[ "$1" == "login" && "$2" == "--local-read-only" ]]; then
  lock_session 30
  exec env -i HOME="$home" PATH=/usr/bin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 "${run_sc[@]}" login --local-read-only
fi

(( $# >= 2 )) || refuse 10 command_not_allowed "no command"
[[ "${!#}" == "--json" ]] || refuse 10 command_not_allowed "--json must be the last argument"
args=("${@:1:$#-1}")

flags=""
case "${args[0]}" in
  whoami|capabilities) n=1 ;;
  overnight)
    case "${args[1]:-}" in
      transactions)
        n=2; flags="--page-size --cursor --type-filter --from-time" ;;
      *) n=1 ;;
    esac ;;
  broker)
    case "${args[1]:-}" in
      context)
        [[ "${args[2]:-}" == "show" ]] || refuse 10 command_not_allowed "command not allowed"
        n=3 ;;
      overview|cash-breakdown|holdings|savings-plans)
        n=2; flags="--portfolio-id" ;;
      transactions)
        n=2; flags="--portfolio-id --page-size --cursor --from-time --to-time" ;;
      transaction)
        [[ "${args[2]:-}" == "details" ]] || refuse 10 command_not_allowed "command not allowed"
        n=3; flags="--portfolio-id --transaction-id" ;;
      *) refuse 10 command_not_allowed "command not allowed" ;;
    esac ;;
  *) refuse 10 command_not_allowed "command not allowed" ;;
esac

rest=("${args[@]:n}")
(( ${#rest[@]} % 2 == 0 )) || refuse 10 command_not_allowed "every flag must carry one value"
seen=" "
for ((i = 0; i < ${#rest[@]}; i += 2)); do
  flag="${rest[i]}"
  value="${rest[i + 1]}"
  [[ " $flags " == *" $flag "* ]] || refuse 10 command_not_allowed "flag not allowed"
  [[ "$seen" != *" $flag "* ]] || refuse 10 command_not_allowed "flag given twice"
  seen+="$flag "
  [[ "$value" != -* ]] || refuse 10 invalid_input "flag value starts with a dash"
  case "$flag" in
    --portfolio-id)   re='^[A-Za-z0-9_-]{1,128}$' ;;
    --transaction-id) re='^[A-Za-z0-9_:.-]{1,128}$' ;;
    --cursor)         re='^[A-Za-z0-9_=+/.:-]{1,512}$' ;;
    --page-size)      re='^([1-9]|[1-9][0-9]|100)$' ;;
    --type-filter)    re='^[A-Z_]{1,40}$' ;;
    --from-time|--to-time)
      re='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$' ;;
    *) refuse 10 command_not_allowed "flag not allowed" ;;
  esac
  [[ "$value" =~ $re ]] || refuse 10 invalid_input "invalid flag value"
done

lock_session 120

exec env -i HOME="$home" PATH=/usr/bin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 "${run_sc[@]}" "${args[@]}" --json
