# QuantFolio Caddy Reverse Proxy Configuration
# TLS termination, reverse proxy, metrics passthrough
# On the web LXC, the API runs on the app LXC. Set APP_UPSTREAM=10.0.0.21:8000
# in Caddy's environment, or rely on the default. The web LXC has no local API.

# ====================================================================
# CONFIGURATION OPTIONS
# ====================================================================

# Domain configuration:
# - Replace {$DOMAIN} with your domain (e.g., quantfolio.example.com)
# - Or use environment variable: export DOMAIN=quantfolio.example.com
# - Default to localhost for LAN-only (self-signed)

(domain) {
  # This snippet is used to set the domain correctly depending on deployment
  # For LAN: remove this block and use :443 directly with self-signed
  # For public: set DOMAIN env var to your domain
}

# ====================================================================
# PRODUCTION: Public domain with Let's Encrypt ACME
# ====================================================================
# Uncomment and adjust if you have a public domain

# https://{$DOMAIN:quantfolio.local} {
#   encode zstd gzip
#
#   # Logs
#   log {
#     output file /var/log/caddy/quantfolio.log
#     format json
#   }
#
#   # Health checks and metrics (pass through, no auth)
#   handle /healthz {
#     reverse_proxy {$APP_UPSTREAM:10.0.0.21:8000}
#   }
#
#   handle /health {
#     reverse_proxy {$APP_UPSTREAM:10.0.0.21:8000}
#   }
#
#   # Metrics endpoint (optionally gated)
#   handle /metrics {
#     reverse_proxy {$APP_UPSTREAM:10.0.0.21:8000}
#   }
#
#   # API endpoints (auth may be required via FastAPI)
#   handle /api/* {
#     reverse_proxy {$APP_UPSTREAM:10.0.0.21:8000}
#   }
#
#   # Frontend static + SPA
#   handle {
#     root * /opt/quantfolio/frontend/dist
#     @noCache path /index.html /sw.js /manifest.webmanifest
#     header @noCache Cache-Control "no-cache"
#     @immutable path /assets/*
#     header @immutable Cache-Control "public, max-age=31536000, immutable"
#     try_files {path} /index.html
#     file_server
#   }
#
#   # TLS via Let's Encrypt (automatic)
#   tls {
#     dns cloudflare {$CLOUDFLARE_API_TOKEN}  # or use acme_dns for other providers
#   }
# }

# ====================================================================
# DEVELOPMENT/LAN: Self-signed TLS
# ====================================================================
# For local Proxmox deployment (web LXC at 10.0.0.23 or quantfolio.local)

# Generate self-signed cert first:
# caddy gen-certificate --ca=local quantfolio.local
# Then uncomment this block:

# https://quantfolio.local:443 {
#   encode zstd gzip
#
#   # Logs
#   log {
#     output stdout
#     format json
#   }
#
#   # Health checks and metrics
#   handle /healthz {
#     reverse_proxy {$APP_UPSTREAM:10.0.0.21:8000}
#   }
#
#   handle /health {
#     reverse_proxy {$APP_UPSTREAM:10.0.0.21:8000}
#   }
#
#   handle /metrics {
#     reverse_proxy {$APP_UPSTREAM:10.0.0.21:8000}
#   }
