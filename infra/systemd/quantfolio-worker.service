[Unit]
Description=QuantFolio Worker
After=network.target postgresql.service redis-server.service

[Service]
# Scalable sync runs `sudo -u scalable-cli-user` (docs/scalable.md): do not add
# NoNewPrivileges, RestrictSUIDSGID, ProtectSystem=strict or ProtectHome here, nor
# any setting that turns NoNewPrivileges on by itself (ProtectKernelTunables and
# the others listed in quantfolio-api.service).
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUTF8=1
WorkingDirectory=/opt/quantfolio/backend
EnvironmentFile=/opt/quantfolio/.env
ExecStart=/opt/quantfolio/backend/.venv/bin/python -m app.worker
Restart=always
RestartSec=5
User=quantfolio

# Sandboxing. See quantfolio-api.service for why NoNewPrivileges, ProtectHome,
# ProtectSystem=strict, RestrictSUIDSGID, ProtectKernelTunables and the other
# seccomp settings (the sudo to scalable-cli-user) and PrivateTmp (the
# /tmp/quantfolio_* directories shared with the API) are left out.
ProtectSystem=full
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
